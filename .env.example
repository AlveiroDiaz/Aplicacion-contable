# Copia este archivo a ".env" (mismo directorio que docker-compose.yml) y
# ajusta los valores según dónde estés desplegando. docker compose lo lee
# automáticamente, sin que tengas que tocar docker-compose.yml.
#
# En local, con los valores por defecto (no hace falta crear el .env) ya
# funciona todo apuntando a localhost.

# Puertos publicados en el host. Cámbialos si ya tienes algo corriendo en
# esos puertos (ej. otro proyecto usando el 3000 u 8000).
FRONTEND_PORT=3000
BACKEND_PORT=8000

# URL pública por la que el NAVEGADOR va a llamar al backend. En un
# servidor remoto, usa la IP o dominio real (con el mismo puerto que
# publicaste arriba en BACKEND_PORT), no "localhost".
# Ejemplo: NEXT_PUBLIC_API_URL=http://203.0.113.10:8000/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Orígenes permitidos por CORS: debe incluir la URL pública real desde la
# que se sirve el frontend (con su puerto). Varios orígenes van separados
# por coma, sin espacios.
# Ejemplo: CORS_ORIGINS=http://203.0.113.10:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Clave que firma los JWT. Genera una propia para cualquier servidor real
# (por ejemplo: openssl rand -hex 32) y NUNCA reutilices el valor de
# ejemplo del repo.
JWT_SECRET_KEY=cambia-esta-clave-en-produccion
